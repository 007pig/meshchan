+// Probe-only metadata on the exact existing Dart event. The plugin's public
+// stream and its event data are left intact.
+typedef MeshchanProbeStamp = ({int generation, int sequence});
+
+final _stamps = Expando<MeshchanProbeStamp>();
+
+MeshchanProbeStamp? meshchanProbeStamp(Object event) => _stamps[event];
+
+void stampMeshchanProbeEvent(Object event, Object? envelope) {
+  if (envelope case [final int generation, final int sequence]) {
+    _stamps[event] = (generation: generation, sequence: sequence);
+  }
+}
