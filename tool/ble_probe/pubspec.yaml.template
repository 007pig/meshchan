name: meshchan_ble_probe
description: Isolated macOS Companion BLE validation host.
publish_to: none
version: 0.1.0+1

environment:
  sdk: ^3.14.0
  flutter: '>=3.50.0'

dependencies:
  flutter:
    sdk: flutter
  bluetooth_low_energy: 6.2.1
  bluetooth_low_energy_darwin: 6.2.1
  bluetooth_low_energy_platform_interface: 6.2.1
  logging: 1.3.0
  material_ui: 1.11.0
  meshcore_link:
    path: ../vendor/meshcore_link

dev_dependencies:
  fake_async: 1.3.3
  flutter_test:
    sdk: flutter
  lints: 6.1.0

dependency_overrides:
  bluetooth_low_energy_darwin:
    path: ../vendor/bluetooth_low_energy_darwin

flutter:
  uses-material-design: true
