+// Probe-only observer for the fixed upstream CentralManagerImpl.
+import CoreBluetooth
+import Foundation
+
+#if os(iOS)
+import Flutter
+#elseif os(macOS)
+import FlutterMacOS
+#endif
+
+final class MeshchanProbeObservation {
+    static var centralAllocations = 0
+    static var peripheralAllocations = 0
+
+    private enum Phase { case armed, connecting, connected, terminal }
+
+    private final class Attempt {
+        let generation: Int64
+        let peripheral: CBPeripheral
+        var phase = Phase.armed
+        var tx: CBCharacteristic?
+        var sequence: Int64 = 0
+        var localRequested = false
+
+        init(generation: Int64, peripheral: CBPeripheral) {
+            self.generation = generation
+            self.peripheral = peripheral
+        }
+    }
+
+    private let channel: FlutterMethodChannel
+    private var attempt: Attempt?
+    private weak var retiredTx: CBCharacteristic?
+    private var lastGeneration: Int64 = 0
+    private let serviceUUID = CBUUID(string: "6E400001-B5A3-F393-E0A9-E50E24DCCA9E")
+    private let txUUID = CBUUID(string: "6E400003-B5A3-F393-E0A9-E50E24DCCA9E")
+
+    init(_ messenger: FlutterBinaryMessenger) {
+        channel = FlutterMethodChannel(
+            name: "org.meshchan.probe.ble2a3/observation",
+            binaryMessenger: messenger
+        )
+    }
+
+    func install(
+        peripheral: @escaping (String) -> CBPeripheral?,
+        characteristic: @escaping (String, Int64) -> CBCharacteristic?,
+        isScanning: @escaping () -> Bool
+    ) {
+        channel.setMethodCallHandler { [weak self] call, result in
+            guard let self = self else {
+                result(false)
+                return
+            }
+            if call.method == "startupCounts" {
+                result([
+                    "central": Self.centralAllocations,
+                    "peripheral": Self.peripheralAllocations,
+                ])
+                return
+            }
+            if call.method == "isScanning" {
+                result(isScanning())
+                return
+            }
+            guard
+                let arguments = call.arguments as? [String: Any],
+                let generation = (arguments["generation"] as? NSNumber)?.int64Value
+            else {
+                result(false)
+                return
+            }
+            switch call.method {
+            case "arm":
+                guard
+                    let id = arguments["target"] as? String,
+                    let selected = peripheral(id)
+                else {
+                    result(false)
+                    return
+                }
+                result(self.arm(generation: generation, peripheral: selected))
+            case "bindTx":
+                guard
+                    let id = arguments["target"] as? String,
+                    let hash = (arguments["characteristic"] as? NSNumber)?.int64Value,
+                    let selected = characteristic(id, hash)
+                else {
+                    result(false)
+                    return
+                }
+                result(self.bindTx(generation: generation, characteristic: selected))
+            case "retire":
+                result(self.retire(generation: generation))
+            default:
+                result(FlutterMethodNotImplemented)
+            }
+        }
+    }
+
+    private func arm(generation: Int64, peripheral: CBPeripheral) -> Bool {
+        guard
+            attempt == nil, generation > lastGeneration,
+            peripheral.state == .disconnected
+        else { return false }
+        attempt = Attempt(generation: generation, peripheral: peripheral)
+        lastGeneration = generation
+        return true
+    }
+
+    private func bindTx(generation: Int64, characteristic: CBCharacteristic) -> Bool {
+        guard
+            let active = attempt, active.generation == generation,
+            active.phase == .connected,
+            active.tx == nil, characteristic !== retiredTx,
+            characteristic.service?.peripheral === active.peripheral,
+            characteristic.service?.uuid == serviceUUID, characteristic.uuid == txUUID
+        else { return false }
+        active.tx = characteristic
+        return true
+    }
+
+    private func retire(generation: Int64) -> Bool {
+        guard
+            let active = attempt, active.generation == generation,
+            active.peripheral.state == .disconnected,
+            active.phase == .armed || active.phase == .terminal
+        else { return false }
+        if let tx = active.tx { retiredTx = tx }
+        attempt = nil
+        return true
+    }
+
+    func connectRequested(_ peripheral: CBPeripheral) {
+        guard let active = matching(peripheral), active.phase == .armed else { return }
+        active.phase = .connecting
+    }
+
+    func disconnectRequested(_ peripheral: CBPeripheral) {
+        guard let active = matching(peripheral), active.phase != .terminal else { return }
+        active.localRequested = true
+    }
+
+    func connected(_ peripheral: CBPeripheral) -> [Int64]? {
+        guard
+            let active = matching(peripheral), active.phase == .connecting,
+            peripheral.state == .connected
+        else { return nil }
+        active.phase = .connected
+        return receipt("connected", active)
+    }
+
+    func failedToConnect(_ peripheral: CBPeripheral) {
+        guard
+            let active = matching(peripheral), active.phase == .connecting,
+            peripheral.state == .disconnected
+        else { return }
+        active.phase = .terminal
+        _ = receipt("connectFailed", active)
+    }
+
+    func disconnected(_ peripheral: CBPeripheral) -> [Int64]? {
+        guard
+            let active = matching(peripheral),
+            active.phase == .connecting || active.phase == .connected,
+            peripheral.state == .disconnected
+        else { return nil }
+        active.phase = .terminal
+        return receipt("disconnected", active, ["localRequested": active.localRequested])
+    }
+
+    func notified(
+        _ peripheral: CBPeripheral,
+        _ characteristic: CBCharacteristic,
+        error: Error?,
+        length: Int
+    ) -> [Int64]? {
+        guard let active = matching(peripheral, characteristic) else { return nil }
+        return receipt("value", active, [
+            "length": length,
+            "errorFree": error == nil,
+            "enabled": characteristic.isNotifying,
+        ])
+    }
+
+    func notifyState(_ peripheral: CBPeripheral, _ characteristic: CBCharacteristic, error: Error?) {
+        guard let active = matching(peripheral, characteristic) else { return }
+        _ = receipt("notifyState", active, [
+            "errorFree": error == nil,
+            "enabled": characteristic.isNotifying,
+        ])
+    }
+
+    private func matching(_ peripheral: CBPeripheral) -> Attempt? {
+        guard let active = attempt, active.peripheral === peripheral else { return nil }
+        return active
+    }
+
+    private func matching(_ peripheral: CBPeripheral, _ characteristic: CBCharacteristic) -> Attempt? {
+        guard
+            let active = matching(peripheral), active.phase == .connected,
+            peripheral.state == .connected, active.tx === characteristic
+        else { return nil }
+        return active
+    }
+
+    // A stamp travels on the original event; the independent receipt contains
+    // only callback metadata. Neither this receipt nor the stamp carries a
+    // device identifier, characteristic identity, or any of the value bytes.
+    private func receipt(_ kind: String, _ active: Attempt, _ fields: [String: Any] = [:]) -> [Int64] {
+        active.sequence += 1
+        var data = fields
+        data["kind"] = kind
+        data["generation"] = active.generation
+        data["sequence"] = active.sequence
+        data["micros"] = Int64(DispatchTime.now().uptimeNanoseconds / 1_000)
+        channel.invokeMethod("receipt", arguments: data)
+        return [active.generation, active.sequence]
+    }
+}
